export function GET(req: NextRequest) {
  // The file name is read from the URL itself, so the folder name can't break this.
  const file = decodeURIComponent(req.nextUrl.pathname.split("/").pop() ?? "");
  const parts = Object.prototype.hasOwnProperty.call(ICONS, file) ? ICONS[file] : null;
  if (!parts) return new NextResponse("Not found", { status: 404 });

  const bytes = Buffer.from(parts.join(""), "base64");
  return new NextResponse(bytes as unknown as BodyInit, {
    headers: {
      "Content-Type": "image/png",
      "Cache-Control": "public, max-age=86400, s-maxage=86400",
    },
  });
}
