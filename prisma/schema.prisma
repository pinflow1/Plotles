generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  penName        String
  hashedPassword String
  avatarUrl      String?
  bio            String?
  genres         String[]        @default([])
  interests      String[]        @default([])
  createdAt      DateTime        @default(now())
  access         ProjectAccess[]
  ideas          Idea[]
  logs           WritingLog[]
  sentRequests     CollaborationRequest[] @relation("SentCollaborationRequests")
  receivedRequests CollaborationRequest[] @relation("ReceivedCollaborationRequests")
}

model Project {
  id            String          @id @default(cuid())
  title         String
  description   String?
  coverUrl      String?
  ownerId       String
  goalWordCount Int?
  deadline      DateTime?
  status        ProjectStatus   @default(drafting)
  // Genre tags and an optional note on what kind of collaborator the
  // story is looking for — shown on Find Stories cards.
  genres        String[]        @default([])
  lookingFor    String?
  // How this story is written — solo by default. Everything about
  // discoverability and identity (public vs private, known vs anonymous)
  // is encoded in this one field rather than a pile of separate booleans,
  // per "these are not cosmetic labels, they determine actual behavior."
  collaborationMode CollaborationMode @default(solo)
  // Total writers INCLUDING the owner — null means uncapped (the public
  // modes). duo/anonymous_duo are always exactly 2 and don't use this.
  maxParticipants   Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  chapters      Chapter[]
  access        ProjectAccess[]
  ideas         Idea[]
  logs          WritingLog[]
  collaborationRequests CollaborationRequest[]
}

enum ProjectStatus {
  planning
  drafting
  revising
  complete
}

enum CollaborationMode {
  solo
  duo
  anonymous_duo
  multiple
  public
  public_anonymous
  private
  private_anonymous
}

// One row per user, per project, per calendar day — the running total for
// that day gets incremented as the chapter's word count changes, so streaks
// and the heatmap are built from real deltas rather than a point-in-time
// snapshot.
model WritingLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  words     Int      @default(0)

  @@unique([userId, projectId, date])
}

model Chapter {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String   @default("Untitled Chapter")
  orderIndex Int      @default(0)
  wordCount  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

enum CollaboratorRole {
  owner
  edit
  view
}

model ProjectAccess {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CollaboratorRole @default(view)
  // Anonymous participation (public_anonymous / private_anonymous / the
  // anonymous_duo match) — the real user is always known internally for
  // permissions, attribution, and abuse handling; this only controls
  // what other participants see. Number is assigned sequentially per
  // project at join time, so "Anonymous Writer 01/02/03" stays stable
  // even if someone else joins or leaves later.
  isAnonymous     Boolean @default(false)
  anonymousNumber Int?

  @@unique([projectId, userId])
}

enum CollaborationRequestStatus {
  pending
  accepted
  rejected
}

// One shared model for every direction a collaboration can start from:
// the owner targeting a specific person (Duo, Private, Multiple), or a
// writer requesting to join something they found (Public, Public
// Anonymous). initiator = whoever created the request, recipient =
// whoever has to respond — which one is the project owner depends on
// the direction, not on a fixed field.
model CollaborationRequest {
  id          String                      @id @default(cuid())
  projectId   String
  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  initiatorId String
  initiator   User                        @relation("SentCollaborationRequests", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User                        @relation("ReceivedCollaborationRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  role        CollaboratorRole            @default(view)
  message     String?
  status      CollaborationRequestStatus  @default(pending)
  createdAt   DateTime                    @default(now())
  respondedAt DateTime?

  @@unique([projectId, recipientId, status])
}

model Idea {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}
