# Postgres connection string, e.g. postgresql://user:password@localhost:5432/plotless
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plotless"

# Any long random string — used to sign/verify auth JWTs.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# From your Liveblocks dashboard (Secret keys), used server-side only
# to mint room access tokens. Never expose this to the client.
LIVEBLOCKS_SECRET_KEY="sk_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
